<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.secu.qa</groupId>
    <artifactId>secu-automation</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>SECU Automation (UI + API)</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Java 23: ADR-0006. Property name: maven-compiler-plugin page "Setting the release of the Java Compiler"
             https://maven.apache.org/plugins/maven-compiler-plugin/examples/set-compiler-release.html -->
        <maven.compiler.release>23</maven.compiler.release>

        <!-- Selenium 4.51.0: https://www.selenium.dev/downloads/ (latest stable Java binding) -->
        <selenium.version>4.51.0</selenium.version>

        <!-- REST Assured 6.1.0: https://central.sonatype.com/artifact/io.rest-assured/rest-assured
             NOTE: sources disagree (wiki says 6.0.1, javadoc.io says 5.5.7). Team picked 6.1.0. -->
        <rest-assured.version>6.1.0</rest-assured.version>

        <!-- JUnit 6.1.3: https://docs.junit.org (latest stable). Needs Java 17+ and Surefire 3.0.0+
             https://docs.junit.org/6.1.3/running-tests/build-support.html -->
        <junit.version>6.1.3</junit.version>

        <!-- Allure + AspectJ: https://allurereport.org/docs/junit5/ -->
        <allure.version>3.0.0</allure.version>
        <aspectj.version>1.9.25</aspectj.version>

        <!-- Plugin versions: surefire from the Allure page above; compiler from the Maven compiler page above -->
        <!-- dotenv-java 3.2.0: https://github.com/cdimascio/dotenv-java (ADR-0011) -->
        <dotenv.version>3.2.0</dotenv.version>

        <surefire.version>3.2.3</surefire.version>
        <compiler-plugin.version>3.16.0</compiler-plugin.version>
        <!-- allure-maven 3.0.2: https://allurereport.org/docs/integrations-maven/ -->
        <allure-maven.version>3.0.2</allure-maven.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- JUnit BOM: lets us omit versions on JUnit artifacts (build-support page) -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Allure BOM (allurereport.org/docs/junit5) -->
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Framework code lives in src/main (ADR-0006), so these are compile scope. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
        </dependency>

        <!-- Tests only -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @Step is used on pages in src/main, so the annotations library is compile scope -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-java-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>${dotenv.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
            </plugin>
            <!-- Surefire config copied from https://allurereport.org/docs/junit5/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <argLine>
                        -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                    </argLine>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.aspectj</groupId>
                        <artifactId>aspectjweaver</artifactId>
                        <version>${aspectj.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!-- mvn allure:report builds target/site/allure-maven-plugin/index.html from target/allure-results -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure-maven.version}</version>
                <!-- one self-contained index.html that opens without a server -->
                <configuration>
                    <singleFile>true</singleFile>
                    <!-- Allure 2 report: allure:serve with Allure 3 showed an empty report (docs/RUN_NOTES.md) -->
                    <reportVersion>2.39.0</reportVersion>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
